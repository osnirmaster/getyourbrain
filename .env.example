# Copie para .env e ajuste.

# Provedor do modelo: bedrock (padrão, roda na conta AWS do banco), anthropic ou ollama (local).
PROVEDOR=bedrock
# Deixe vazio para usar o padrão do provedor:
#   bedrock   -> global.anthropic.claude-opus-5-5 (confira o ID/perfil de inferência liberado no console do Bedrock)
#   anthropic -> claude-opus-5-5
#   ollama    -> qwen3:32b
MODEL_ID=
AWS_REGION=us-east-1
# Guardrail do Bedrock (recomendado: filtro de PII e tópicos negados)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Só para PROVEDOR=anthropic
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# xerj (busca em código e documentos)
XERJ_BIN=~/.local/bin/xerj
XERJ_URL=http://localhost:9200
# Se vazio, lê dados/xerj/admin.key gerado no primeiro boot
XERJ_API_KEY=
XERJ_DATA_DIR=./dados/xerj

# CortexDB (grafo de regras de negócio)
CORTEXDB_MCP_BIN=~/.local/bin/cortexdb-mcp
CORTEXDB_PATH=./dados/cortexdb.db
